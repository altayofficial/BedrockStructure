{
  "name": "altayofficial/bedrockstructure",
  "description": "Read, write and edit Minecraft Bedrock Edition .mcstructure files on Altay",
  "type": "library",
  "license": "GPL-3.0-or-later",
  "require": {
    "php": "^8.1",
    "php-64bit": "*",
    "ext-encoding": "^1.0.0",
    "ext-zlib": "*",
    "altayofficial/nbt": "~1.3.0"
  },
  "require-dev": {
    "altayofficial/altay": "^5.45.1",
    "phpunit/phpunit": "^10.5.24",
    "phpstan/phpstan": "2.1.46",
    "phpstan/phpstan-strict-rules": "^2.0.0"
  },
  "autoload": {
    "psr-4": {
      "altay\\bedrockstructure\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "altay\\bedrockstructure\\tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse"
  }
}
